# ---------------------------------------------------------------------------
# Copia este archivo como ".env" y completa solo lo que tengas.
# Nada de esto es obligatorio: sin configuracion el sitio funciona en modo local.
#
# IMPORTANTE: con Firebase, la configuracion web (apiKey, projectId, etc.) NO es
# un secreto: viaja en el navegador por diseno. La seguridad real la dan las
# reglas de firestore.rules y Firebase Auth. NUNCA pongas aca claves privadas
# (service account, Gemini API key, tokens de GitHub).
# ---------------------------------------------------------------------------

# URL publica del sitio (se usa para canonical, Open Graph y sitemap)
SITE_URL=https://totoaromistica.vercel.app

# Firebase (consola -> Configuracion del proyecto -> Tus apps -> SDK setup)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
